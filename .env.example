# コピーして .env にリネーム。.env は git 管理外。
# Jev (TypeSafe AI) の API キー: https://typesafe.ai/
TYPESAFE_API_KEY=

# Web 検索。設定された鍵のプロバイダを順に試し、429 や失敗で次へフェイルオーバーする。
# 順序: Google → Brave → (無ければ Wikipedia。大手しか載っていないので開発用)
#
# Google Programmable Search: https://programmablesearchengine.google.com/
#   2026-01-20 以降「ウェブ全体を検索」は新規作成できないので、「検索するサイト」に VTuber がいる場所を列挙する (50 ドメインまで):
#   youtube.com, x.com, twitter.com, twitch.tv, virtualyoutuber.fandom.com, seesaawiki.jp, wikiwiki.jp, dic.pixiv.net,
#   virtual-youtuber.userlocal.jp, ja.wikipedia.org, hololive.hololivepro.com, nijisanji.jp, vspo.jp, lit.link, booth.pm, note.com
#   検索エンジン ID を GOOGLE_CSE_CX に、https://developers.google.com/custom-search/v1/introduction の API キーを GOOGLE_CSE_KEY に
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Brave Search API (無料プラン 2,000 回/月): https://brave.com/search/api/
BRAVE_API_KEY=

# Monid (https://monid.ai) 経由の検索。アカウントを作り https://app.monid.ai/access/api-keys で鍵を発行。
# どのツールを呼ぶかは `monid discover -q "web search"` → `monid inspect -p <provider> -e <endpoint>` で確認して設定する。
# MONID_SEARCH_BODY は inspect の body スキーマに合わせた JSON。"{query}" と "{n}" が置換される。
MONID_API_KEY=
MONID_SEARCH_PROVIDER=tinyfish
MONID_SEARCH_ENDPOINT=/search
MONID_SEARCH_BODY={"query":"{query}"}

# プロバイダの試行順 (カンマ区切り)。既定: google,brave,monid。鍵の無いものは飛ばされる。
SEARCH_ORDER=brave,monid
