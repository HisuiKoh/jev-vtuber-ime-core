{
  "name": "jev-vtuber-ime-core",
  "version": "0.2.0",
  "description": "読みから VTuber の表記を、表記から読みを、Web 検索の根拠 + Jev (TypeSafe AI) の判定で解決する。辞書データは持たない。",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "jev-vtuber-ime": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "eval:indie": "tsx scripts/eval-indie.ts",
    "eval:reading": "tsx scripts/eval-reading.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
